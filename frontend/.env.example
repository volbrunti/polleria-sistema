# Base absoluta de la API en producción (la URL pública del backend). En dev
# se usa el proxy de Vite (ver vite.config.ts) y puede quedar vacía.
VITE_API_URL=

# Muestra los botones "DEMO — entrar directo como…" del login. En dev salen
# siempre. En un build de producción SOLO si esto vale exactamente "true":
# las contraseñas van dentro del bundle, así que activarlo en una URL pública
# es dejar un botón de "entrar como administrador" a la vista de cualquiera.
VITE_MOSTRAR_DEMO=
