# URL del backend en Railway (o local, ej. http://localhost:3000 para probar).
BACKEND_URL=https://tu-backend.up.railway.app

# Token de esta sucursal, generado desde el panel:
# Catálogo → Comanderas → Agente de impresión → "Generar token".
# Se muestra una sola vez — si lo perdiste, generá uno nuevo (invalida el anterior).
AGENTE_TOKEN=
