# ── Base de datos ──
# Connection string de Neon. Usar la variante -pooler para la app.
DATABASE_URL="postgresql://usuario:clave@host/basedatos?sslmode=require"
# Base separada SOLO para los tests de integración: los borra enteros antes
# de cada archivo. NUNCA apuntarla a la base real.
DATABASE_URL_TEST="postgresql://usuario:clave@host/polleria_test?sslmode=require"

# ── Secretos de sesión ──
# En producción son obligatorios: si falta alguno, el server no arranca.
# Generar uno distinto por variable, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="otro-secreto-distinto-del-anterior"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DIAS="7"

# ── Usuario inicial (solo lo lee el seed) ──
# El sistema arranca con UN solo usuario administrador; el resto se crea desde
# su panel. En producción el seed aborta si no está definida.
ADMIN_INICIAL_USUARIO="admin"
ADMIN_INICIAL_PASSWORD=""

# ── Servidor ──
PORT="3000"
NODE_ENV="development"

# Dominios del frontend que pueden hablarle a la API, separados por coma y
# SIN barra final. Obligatorio en producción: como la cookie de refresh viaja
# con sameSite=none, aceptar cualquier origen dejaría que otro sitio haga
# requests autenticadas con la sesión del usuario. En desarrollo, si está
# vacío, se acepta cualquier origen.
ORIGENES_PERMITIDOS="https://polleria.tudominio.com"

# Fotos de remito: fallback de disco local, SOLO para desarrollar sin
# credenciales de R2 (ver abajo). En la nube el disco del contenedor se
# borra en cada deploy — R2 lo reemplaza, no hace falta volumen.
DIR_UPLOADS="uploads"

# ── Fotos de remito (Cloudflare R2) ──
# Opcionales en desarrollo (sin ellas, las fotos van al disco local de
# arriba). OBLIGATORIAS en producción: el server no arranca si falta alguna.
# Ver DEPLOY.md §2.3 para crear el bucket y el token de API.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_URL_PUBLICA=""
